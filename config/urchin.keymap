#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <10 11>;
            layers = <0>;
        };

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <11 12>;
            layers = <0>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
            layers = <0>;
        };

        rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 18>;
            layers = <0>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 17>;
            layers = <0>;
        };

        rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 16>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <20 21>;
            layers = <0>;
        };

        langle {
            bindings = <&kp LESS_THAN>;
            key-positions = <21 22>;
            layers = <0>;
        };

        squote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <22 23>;
            layers = <0>;
        };

        dquote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <26 27>;
            layers = <0>;
        };

        rangle {
            bindings = <&kp GREATER_THAN>;
            key-positions = <27 28>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <28 29>;
            layers = <0>;
        };

        game {
            bindings = <&tog 1>;
            key-positions = <30 33>;
            layers = <0 1>;
        };

        bt0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <30 31>;
            layers = <0>;
        };

        bt1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <32 33>;
            layers = <0>;
        };

        bt_clr {
            bindings = <&bt BT_CLR>;
            key-positions = <30 31 33 32>;
            layers = <0>;
        };
    };

    behaviors {
        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&caps_word>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W  &kp E  &kp R           &kp T      &kp Y             &kp U              &kp I  &kp O      &kp P
&kp A  &kp S  &kp D  &kp F           &kp G      &kp H             &kp J              &kp K  &kp L      &kp SEMI
&kp Z  &kp X  &kp C  &kp V           &kp B      &kp B             &kp N              &kp M  &kp COMMA  &kp DOT
                     &lt 2 LEFT_GUI  &kp LCTRL  &mt RSHIFT SPACE  &lt (3) LG(SPACE)
            >;
        };

        game {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R      &kp N3  &kp N4    &kp N5    &kp N6     &kp N7
&kp LSHFT  &kp A  &kp S  &kp D  &kp F      &kp N2  &kp K     &kp UP    &kp L      &kp RSHFT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V      &kp N1  &kp LEFT  &kp DOWN  &kp RIGHT  &kp RCTRL
                         &mo 2  &kp SPACE  &kp J   &mo 3
            >;
        };

        mod {
            bindings = <
&kp ESCAPE    &kp LC(LA(LEFT))  &kp F2               &kp LC(LA(RIGHT))  &kp TAB          &kp C_BRIGHTNESS_DEC  &kp HOME   &kp END    &kp C_BRIGHTNESS_INC  &kp BACKSPACE
&kp LEFT_WIN  &kp LALT          &auto_shift LSHFT 0  &kp LCTRL          &kp DELETE       &kp LEFT              &kp DOWN   &kp UP     &kp RIGHT             &kp RET
&kp CAPSLOCK  &kp F3            &kp F4               &kp F5             &kp PRINTSCREEN  &kp C_VOLUME_DOWN     &kp PG_DN  &kp PG_UP  &kp C_VOL_UP          &kp DELETE
                                                     &none              &none            &none                 &none
            >;
        };

        symbol {
            bindings = <
&kp ASTERISK  &kp N1  &kp N2  &kp N3  &kp PLUS   &kp CARET  &kp AT     &kp HASH   &kp DLLR   &kp BSPC
&kp SLASH     &kp N4  &kp N5  &kp N6  &kp MINUS  &kp EXCL   &kp PIPE   &kp AMPS   &kp EQUAL  &kp RET
&kp DOT       &kp N7  &kp N8  &kp N9  &kp GRAVE  &kp UNDER  &kp PRCNT  &kp TILDE  &kp QMARK  &kp DELETE
                              &kp N0  &none      &none      &none
            >;
        };
    };
};
