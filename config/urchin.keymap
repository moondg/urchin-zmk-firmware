#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <10 11>;
            layers = <0>;
        };

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <11 12>;
            layers = <0>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
            layers = <0>;
        };

        rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 18>;
            layers = <0>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 17>;
            layers = <0>;
        };

        rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 16>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <20 21>;
            layers = <0>;
        };

        langle {
            bindings = <&kp LESS_THAN>;
            key-positions = <21 22>;
            layers = <0>;
        };

        squote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <22 23>;
            layers = <0>;
        };

        dquote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <26 27>;
            layers = <0>;
        };

        rangle {
            bindings = <&kp GREATER_THAN>;
            key-positions = <27 28>;
            layers = <0>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <28 29>;
            layers = <0>;
        };

        game {
            bindings = <&tog 1>;
            key-positions = <30 33>;
            layers = <0 1>;
        };

        l_reset {
            bindings = <&bootloader_ht 0 0>;
            key-positions = <30 31>;
            layers = <0>;
        };

        r_reset {
            bindings = <&bootloader_ht 0 0>;
            key-positions = <32 33>;
            layers = <0>;
        };
    };

    behaviors {
        auto_caps_tab_dance: auto_caps_tab_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "AUTO_CAPS_TAB_DANCE";
            #binding-cells = <0>;
            bindings = <&kp CAPSLOCK>, <&caps_word>;
        };

        auto_caps: auto_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_CAPS";
            bindings = <&kp>, <&auto_caps_tab_dance>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        bt_ht: bt_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_clear>, <&bt_select>;

            label = "BT_HT";
        };

        bootloader_ht: bootloader_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "BOOTLOADER_HT";
            bindings = <&bootloader>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <3000>;
            flavor = "tap-preferred";
        };
    };

    macros {
        bt_select: bt_select {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        bt_clear: bt_clear {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &bt MACRO_PLACEHOLDER MACRO_PLACEHOLDER &bt BT_CLR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W  &kp E  &kp R           &kp T      &kp Y             &kp U              &kp I  &kp O      &kp P
&kp A  &kp S  &kp D  &kp F           &kp G      &kp H             &kp J              &kp K  &kp L      &kp SEMI
&kp Z  &kp X  &kp C  &kp V           &kp B      &kp B             &kp N              &kp M  &kp COMMA  &kp DOT
                     &lt 2 LEFT_GUI  &kp LCTRL  &mt RSHIFT SPACE  &lt (3) LG(SPACE)
            >;
        };

        game {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R      &kp N3  &kp N4    &kp N5    &kp N6     &kp N7
&kp LSHFT  &kp A  &kp S  &kp D  &kp F      &kp N2  &kp J     &kp UP    &kp L      &kp RSHFT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V      &kp N1  &kp LEFT  &kp DOWN  &kp RIGHT  &kp RCTRL
                         &mo 2  &kp SPACE  &kp H   &none
            >;
        };

        mod {
            bindings = <
&kp ESCAPE    &kp LC(LA(LEFT))  &kp F2              &kp LC(LA(RIGHT))  &kp TAB          &kp C_BRIGHTNESS_DEC  &kp HOME    &kp END    &kp C_BRIGHTNESS_INC  &kp BACKSPACE
&kp LEFT_WIN  &kp LALT          &auto_caps LSHFT 0  &kp LCTRL          &kp DELETE       &kp LEFT              &kp DOWN    &kp UP     &kp RIGHT             &kp RET
&none         &kp F3            &kp F4              &kp F5             &kp PRINTSCREEN  &kp C_VOLUME_DOWN     &kp PG_DN   &kp PG_UP  &kp C_VOL_UP          &kp DELETE
                                                    &none              &none            &bt_ht 0 0            &bt_ht 1 1
            >;
        };

        symbol {
            bindings = <
&kp ASTERISK  &kp N1  &kp N2  &kp N3  &kp PLUS   &kp EQUAL  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp BSPC
&kp SLASH     &kp N4  &kp N5  &kp N6  &kp MINUS  &kp UNDER  &kp DOLLAR       &kp PERCENT  &kp CARET  &kp RET
&kp DOT       &kp N7  &kp N8  &kp N9  &kp COMMA  &kp TILDE  &kp AMPERSAND    &kp GRAVE    &kp PIPE   &kp DELETE
                              &kp N0  &none      &none      &none
            >;
        };
    };
};
