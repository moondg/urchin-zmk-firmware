#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        lbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <10 11>;
            layers = <0>;
        };

        lbrace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <11 12>;
            layers = <0>;
        };

        lparen {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <12 13>;
            layers = <0>;
        };

        rbracket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 18>;
            layers = <0>;
        };

        rbrace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 17>;
            layers = <0>;
        };

        rparen {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 16>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <20 21>;
        };

        langle {
            bindings = <&kp LESS_THAN>;
            key-positions = <21 22>;
        };

        squote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <22 23>;
        };

        dquote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <26 27>;
        };

        rangle {
            bindings = <&kp GREATER_THAN>;
            key-positions = <27 28>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <28 29>;
            layers = <0>;
        };

        game {
            bindings = <&tog 1>;
            key-positions = <30 33>;
            layers = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q  &kp W  &kp E  &kp R           &kp T      &kp Y             &kp U              &kp I  &kp O      &kp P
&kp A  &kp S  &kp D  &kp F           &kp G      &kp H             &kp J              &kp K  &kp L      &kp SEMI
&kp Z  &kp X  &kp C  &kp V           &kp B      &kp B             &kp N              &kp M  &kp COMMA  &kp DOT
                     &lt 2 LEFT_GUI  &kp LCTRL  &mt RSHIFT SPACE  &lt (3) LS(SPACE)
            >;
        };

        game {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R      &kp N3  &kp N4  &kp N5    &kp N6   &kp N7
&kp LSHFT  &kp A  &kp S  &kp D  &kp F      &kp N2  &kp L   &kp SEMI  &kp SQT  &kp RSHFT
&kp LCTRL  &kp Z  &kp C  &kp X  &kp V      &kp N1  &none   &none     &none    &kp RCTRL
                         &mo 2  &kp SPACE  &kp J   &none
            >;
        };

        mode {
            bindings = <
&kp ESCAPE    &kp LC(LA(LEFT))  &kp F2     &kp LC(LA(RIGHT))  &kp TAB     &kp F5             &kp HOME   &kp END    &none         &kp BACKSPACE
&kp LEFT_WIN  &kp LALT          &kp LSHFT  &kp LCTRL          &kp DELETE  &kp LEFT           &kp DOWN   &kp UP     &kp RIGHT     &kp RET
&none         &none             &none      &none              &none       &kp C_VOLUME_DOWN  &kp PG_DN  &kp PG_UP  &kp C_VOL_UP  &none
                                           &none              &none       &caps_word         &none
            >;
        };

        symbol {
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp MINUS       &kp EQUAL  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp BSPC
&none  &kp N4  &kp N5  &kp N6  &kp UNDERSCORE  &kp PLUS   &kp DOLLAR       &kp PERCENT   &kp CARET  &kp RET
&none  &kp N7  &kp N8  &kp N9  &kp GRAVE       &kp TILDE  &kp AMPERSAND    &kp ASTERISK  &kp PIPE   &none
                       &kp N0  &none           &none      &none
            >;
        };
    };
};
